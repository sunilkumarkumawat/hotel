# ── The PDF that goes with a guest's WhatsApp message ──────────────────────
# Booking confirmation, registration slip, final bill — the guest gets the
# message AND a proper document to keep. What each one says is
# config/guest-documents.php.
#
# IT ONLY WORKS ON A PUBLIC ADDRESS. WhatsApp does not receive the file, it
# receives a link and goes and fetches it, so while APP_URL is
# http://127.0.0.1:8000 there is nothing for it to fetch and the message is
# sent on its own. Administration -> Notification Settings says so on screen.
# Put the hotel's real web address on the APP_URL line above and attachments
# start working with nothing else changed.
PMS_GUEST_PDF=true

# The PDF goes out on BOTH channels, and only one of them needs an address:
#
#   Email     carries the file itself. Works from a laptop, works from a
#             server, needs nothing set here.
#   WhatsApp  is handed a LINK and fetches the file itself, so it needs an
#             address the internet can reach.
#
# On a real server APP_URL above is that address and this line stays empty.
# On a laptop, point a tunnel (ngrok, cloudflared) at this application and put
# its address here — WhatsApp attachments then work without moving the whole
# application off 127.0.0.1.
PMS_PUBLIC_URL=
PMS_GUEST_DOC_DAYS=30


# LIVE:
 PMS_PUBLIC_URL=https://randy-sculpture-affects-relevance.trycloudflare.com

